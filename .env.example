# ═══════════════════════════════════════════════════════════════
#  IT Support Chatbot — Environment Variables
#  Copy this file to .env and fill in your keys
# ═══════════════════════════════════════════════════════════════

# ── OPTION A: Google Gemini (RECOMMENDED - 100% Free) ──────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free limits: 15 requests/min · 1,500 requests/day · No credit card
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPTION B: Groq (Also Free - Very Fast) ────────────────────
# Get your free key at: https://console.groq.com
# Free limits: 30 requests/min · No credit card needed
GROQ_API_KEY=your_groq_api_key_here

# ── NOTE ───────────────────────────────────────────────────────
# You only need ONE key. The bot will:
#   1. Use Gemini if GEMINI_API_KEY is set
#   2. Fall back to Groq if GROQ_API_KEY is set
#   3. Use a built-in response if neither key is set
# ──────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────
# Local MongoDB (default — works after installing MongoDB Community)
MONGODB_URI=mongodb://localhost:27017/it_support_chatbot
# Cloud (MongoDB Atlas free tier): replace with your Atlas connection string
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/it_support

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
